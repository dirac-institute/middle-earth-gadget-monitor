{
  "uid": "gadget-globus",
  "title": "Globus",
  "description": "Globus Connect Server nodes in config/globus.toml, probed from the monitoring VM every minute.",
  "tags": [
    "gadget-monitor"
  ],
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gadget_globus_up, server)",
          "refId": "server"
        },
        "definition": "label_values(gadget_globus_up, server)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Health",
      "description": "Each node's GCS Manager, asked for /api/info from the monitoring VM every minute. Healthy: answered 200 with code \"success\". Unhealthy: the node's HTTPS port answered, but not that (a 502 with the Manager down, a certificate that doesn't verify, a broken answer). Unreachable: no answer on the port at all. Unknown: no Globus domain configured for the node, so only reachability is tested. Data transfers (GridFTP) aren't tested.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "3 * sum by (server) (gadget_globus_state{server=~\"$server\", state=\"healthy\"}) + 2 * sum by (server) (gadget_globus_state{server=~\"$server\", state=\"unknown\"}) + sum by (server) (gadget_globus_state{server=~\"$server\", state=\"unhealthy\"})",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "Healthy",
                  "color": "#0ca30c",
                  "index": 0
                },
                "2": {
                  "text": "Unknown (no domain)",
                  "color": "#8e8e8e",
                  "index": 1
                },
                "1": {
                  "text": "Unhealthy",
                  "color": "#d03b3b",
                  "index": 2
                },
                "0": {
                  "text": "Unreachable",
                  "color": "#8a1c1c",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8a1c1c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              },
              {
                "color": "#8e8e8e",
                "value": 2
              },
              {
                "color": "#0ca30c",
                "value": 3
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1m"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy, selected range",
      "description": "Share of probes over the selected time range that found the node healthy. Nodes with no Globus domain configured aren't shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time(gadget_globus_up{server=~\"$server\"}[$__range]) and on (server) (min_over_time(gadget_globus_state{server=~\"$server\", state=\"unknown\"}[$__range]) == 0)",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.99
              },
              {
                "color": "#0ca30c",
                "value": 0.999
              }
            ]
          },
          "noValue": "No domain configured",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Certificate expires in",
      "description": "Time until the certificate the node served for its Globus domain on its last successful handshake expires. Globus renews these automatically.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server) (gadget_globus_cert_expiry_timestamp_seconds{server=~\"$server\"}) - time()",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 604800
              },
              {
                "color": "#0ca30c",
                "value": 1814400
              }
            ]
          },
          "noValue": "No domain configured"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Response time",
      "description": "Time for the whole probe: TCP connect, TLS handshake and the /api/info answer. A failed probe shows the time until it failed; timeouts show as 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_globus_seconds{server=~\"$server\", stage=\"total\"}",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failures by state",
      "description": "Failed probes per minute: unhealthy (the port answered, the Manager didn't say success) or unreachable (no answer). The collector's log has the reason for each. Empty is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (server, state) (gadget_globus_state{server=~\"$server\", state=~\"unhealthy|unreachable\"}) > 0",
          "legendFormat": "{{server}} {{state}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "No failures",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP status",
      "description": "Status code of the /api/info answer. 0 means no answer at all; 404 is a node with no domain configured (Apache's default site).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_globus_http_status{server=~\"$server\"}",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "stat",
      "title": "GCS version",
      "description": "Globus Connect Server Manager version each node reported on its last healthy probe (within 10 minutes).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server, version) (last_over_time(gadget_globus_manager_info{server=~\"$server\"}[10m]))",
          "legendFormat": "{{server}}: {{version}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "No healthy probe"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    }
  ]
}
