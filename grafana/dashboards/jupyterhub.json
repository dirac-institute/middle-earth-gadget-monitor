{
  "uid": "gadget-jupyterhub",
  "title": "JupyterHub",
  "description": "JupyterHubs in config/jupyterhubs.toml, probed from the monitoring VM every minute, and the hub processes on their hosts.",
  "tags": [
    "gadget-monitor"
  ],
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "hub",
        "label": "Hub",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gadget_jupyterhub_up, hub)",
          "refId": "hub"
        },
        "definition": "label_values(gadget_jupyterhub_up, hub)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Hub answers",
      "description": "Whether each hub's API root (<url>hub/api) answered 200 with the hub's version within 15 s, probed from the monitoring VM every minute. That needs the host's web server, the proxy and the hub itself all working. It does not test starting a server or a kernel. 'Failures by reason' says why a probe failed, and 'Hub processes' which piece is missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (hub) (gadget_jupyterhub_up{hub=~\"$hub\"})",
          "legendFormat": "{{hub}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "Down",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1m"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime, selected range",
      "description": "Share of probes over the selected time range that found the hub answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time(gadget_jupyterhub_up{hub=~\"$hub\"}[$__range])",
          "legendFormat": "{{hub}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.99
              },
              {
                "color": "#0ca30c",
                "value": 0.999
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Certificate expires in",
      "description": "Time until the TLS certificate the hub's host served on its last successful handshake expires.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (hub) (gadget_jupyterhub_cert_expiry_timestamp_seconds{hub=~\"$hub\"}) - time()",
          "legendFormat": "{{hub}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 604800
              },
              {
                "color": "#0ca30c",
                "value": 1814400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Response time",
      "description": "Time for the hub to answer its API root, from DNS lookup to the last byte. The answer is tiny, so this is the web server's, proxy's and hub's own latency: a busy or stuck hub shows here first. A failed probe shows the time until it failed; timeouts show as 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"total\"}",
          "legendFormat": "{{hub}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failures by reason",
      "description": "Failed probes per minute, by reason. http_error: answered with anything but 200 (a 502 or 503 usually means the proxy or hub behind the web server is down); timeout: no complete answer within 15 s; dns_error, connect_error, tls_error: failed at that step; error: a 200 that wasn't the hub's answer, or a broken response. Empty is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (hub, status) (gadget_jupyterhub_status{hub=~\"$hub\", status!=\"ok\"}) > 0",
          "legendFormat": "{{hub}} {{status}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "No failures",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Running servers",
      "description": "Single-user servers running on each hub's host: one per user with a server started, busy or idle. Counted from the host's processes every 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (host) (gadget_jupyterhub_processes{host=~\"$hub\", process=\"singleuser\"})",
          "legendFormat": "{{host}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 600000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Hub processes",
      "description": "Whether the hub and its proxy (configurable-http-proxy) are running on each host, checked every 5 minutes. Both running while the hub doesn't answer means the hub is stuck. Without the proxy, users can't reach their running servers either.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (host, process) (gadget_jupyterhub_processes{host=~\"$hub\", process=~\"hub|proxy\"})",
          "legendFormat": "{{host}} {{process}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not running",
                  "color": "#d03b3b",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "Running",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "5m"
    },
    {
      "id": 8,
      "type": "table",
      "title": "JupyterHub version",
      "description": "Version each hub reported in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (hub, version) (last_over_time(gadget_jupyterhub_info{hub=~\"$hub\"}[1h]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "interval": "1m",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "hub": "Hub",
              "version": "Version"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Response time by stage: $hub",
      "description": "Where the response time goes, stacked. dns: name lookup; connect: TCP; tls: handshake and certificate check; response: request sent until the headers arrive (the web server, proxy and hub); body: reading the answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"dns\"}",
          "legendFormat": "dns",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"connect\"}",
          "legendFormat": "connect",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"tls\"}",
          "legendFormat": "tls",
          "refId": "C",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"response\"}",
          "legendFormat": "response",
          "refId": "D",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "gadget_jupyterhub_seconds{hub=~\"$hub\", stage=\"body\"}",
          "legendFormat": "body",
          "refId": "E",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dns"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "connect"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tls"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "response"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008300"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "body"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9085e9"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1m",
      "repeat": "hub",
      "repeatDirection": "h",
      "maxPerRow": 2
    }
  ]
}
