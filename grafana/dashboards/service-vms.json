{
  "uid": "gadget-service-vms",
  "title": "Service VMs",
  "description": "CPU, memory and disks of the VMs in config/service_vms.toml, polled from the monitoring VM every minute.",
  "tags": [
    "gadget-monitor"
  ],
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service_vm",
        "label": "Service VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gadget_service_vm_up, service_vm)",
          "refId": "service_vm"
        },
        "definition": "label_values(gadget_service_vm_up, service_vm)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Monitor reachable",
      "description": "Whether the VM's service VM monitor answered the collector's poll (every minute, from the monitoring VM). Down means the VM, its network, or the monitor container is down; the panels below have a gap for that time.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (service_vm) (gadget_service_vm_up{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "Down",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fullest filesystem",
      "description": "The highest share of space used among each VM's local filesystems. 'Filesystem used' below has every filesystem.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (service_vm) (1 - max by (service_vm, mountpoint) (service_vm_filesystem_avail_bytes{service_vm=~\"$service_vm\"}) / max by (service_vm, mountpoint) (service_vm_filesystem_size_bytes{service_vm=~\"$service_vm\"}))",
          "legendFormat": "{{service_vm}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.8
              },
              {
                "color": "#d03b3b",
                "value": 0.9
              }
            ]
          },
          "noValue": "No data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Up since",
      "description": "Time since each VM last booted.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - max by (service_vm) (service_vm_boot_time_seconds{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "row",
      "title": "CPU and memory",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Share of the VM's CPU time spent on anything but idle, averaged over its cores. Includes waiting on disk (iowait) and time taken by the hypervisor (steal), which 'CPU waiting' shows separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm) (rate(service_vm_cpu_seconds_total{service_vm=~\"$service_vm\", mode!=\"idle\"}[$__rate_interval])) / max by (service_vm) (service_vm_cpu_count{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU waiting",
      "description": "iowait: cores idle while a process waits on disk. steal: time the hypervisor gave this VM's cores to something else; steady steal means the host is oversubscribed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm) (rate(service_vm_cpu_seconds_total{service_vm=~\"$service_vm\", mode=\"iowait\"}[$__rate_interval])) / max by (service_vm) (service_vm_cpu_count{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}} iowait",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm) (rate(service_vm_cpu_seconds_total{service_vm=~\"$service_vm\", mode=\"steal\"}[$__rate_interval])) / max by (service_vm) (service_vm_cpu_count{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}} steal",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load per core",
      "description": "5-minute load average divided by the number of cores. Above 1, processes are queuing for CPU (or stuck waiting on disk or NFS, which also counts as load on Linux).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (service_vm) (service_vm_load5{service_vm=~\"$service_vm\"}) / max by (service_vm) (service_vm_cpu_count{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Memory in use (total minus available: what can't be reclaimed without swapping), and swap in use, as a share of each. A VM without swap has no swap line.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - max by (service_vm) (service_vm_memory_available_bytes{service_vm=~\"$service_vm\"}) / max by (service_vm) (service_vm_memory_total_bytes{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}} memory",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - max by (service_vm) (service_vm_swap_free_bytes{service_vm=~\"$service_vm\"}) / max by (service_vm) (service_vm_swap_total_bytes{service_vm=~\"$service_vm\"} > 0)",
          "legendFormat": "{{service_vm}} swap",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 10,
      "type": "row",
      "title": "Disks",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Filesystem used",
      "description": "Share of space used on each local filesystem (xfs, ext4, btrfs). Network filesystems such as /service/shire are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "1 - max by (service_vm, mountpoint) (service_vm_filesystem_avail_bytes{service_vm=~\"$service_vm\"}) / max by (service_vm, mountpoint) (service_vm_filesystem_size_bytes{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}} {{mountpoint}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Filesystem free",
      "description": "Space left on each local filesystem for ordinary users.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (service_vm, mountpoint) (service_vm_filesystem_avail_bytes{service_vm=~\"$service_vm\"})",
          "legendFormat": "{{service_vm}} {{mountpoint}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Disk throughput",
      "description": "Bytes read from and written to each of the VM's disks per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm, device) (rate(service_vm_disk_read_bytes_total{service_vm=~\"$service_vm\"}[$__rate_interval]))",
          "legendFormat": "{{service_vm}} {{device}} read",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm, device) (rate(service_vm_disk_written_bytes_total{service_vm=~\"$service_vm\"}[$__rate_interval]))",
          "legendFormat": "{{service_vm}} {{device}} write",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Disk busy",
      "description": "Share of time each disk had at least one request in flight. Near 100% the disk is the bottleneck (on virtual disks, which serve requests in parallel, it can be busy without being saturated).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service_vm, device) (rate(service_vm_disk_io_seconds_total{service_vm=~\"$service_vm\"}[$__rate_interval]))",
          "legendFormat": "{{service_vm}} {{device}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    }
  ]
}
