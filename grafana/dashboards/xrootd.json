{
  "uid": "gadget-xrootd",
  "title": "Xrootd",
  "description": "xrootd servers in config/xrootd.toml, probed from the monitoring VM every minute.",
  "tags": [
    "gadget-monitor"
  ],
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gadget_xrootd_up, server)",
          "refId": "server"
        },
        "definition": "label_values(gadget_xrootd_up, server)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Up",
      "description": "Probed from the monitoring VM every minute. Host: the host answers on TCP (SSH port). xrootd: the server completes the xrootd handshake, TLS and a login request, up to asking for authentication. The probe has no credentials, so this doesn't show whether authenticated users can read or write data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server) (gadget_xrootd_vm_up{server=~\"$server\"})",
          "legendFormat": "{{server}} host",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server) (gadget_xrootd_up{server=~\"$server\"})",
          "legendFormat": "{{server}} xrootd",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "Down",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "xrootd up, selected range",
      "description": "Share of probes over the selected time range in which xrootd answered as far as login.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time(gadget_xrootd_up{server=~\"$server\"}[$__range])",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.99
              },
              {
                "color": "#0ca30c",
                "value": 0.999
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Host certificate expires in",
      "description": "Time left on the certificate xrootd presents for TLS, its host certificate (also used for GSI). Amber under 30 days, red under 7. No value: the server didn't get as far as TLS in the last probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server) (gadget_xrootd_cert_expiry_timestamp_seconds{server=~\"$server\"}) - time()",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 604800
              },
              {
                "color": "#0ca30c",
                "value": 2592000
              }
            ]
          },
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "row",
      "title": "Probe detail",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failures by reason",
      "description": "Failed probes per minute, by reason. refused: nothing listening on the xrootd port; timeout: no answer within 15 s; connect_error: no route, or the name doesn't resolve; tls_error: the TLS handshake failed; protocol_error: something answered, but not as an xrootd server should (or it refused the login); error: anything else. Empty is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (server, status) (gadget_xrootd_status{server=~\"$server\", status!=\"ok\"}) > 0",
          "legendFormat": "{{server}} {{status}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "No failures",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0,
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe time",
      "description": "How long each stage of the probe took. connect: TCP connect; handshake: the xrootd handshake and protocol request; tls: switching the session to TLS; login: the login request until the server answers; total: the whole probe, also recorded up to the failure when a probe fails (a timeout shows as 15 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (server, stage) (gadget_xrootd_seconds{server=~\"$server\"})",
          "legendFormat": "{{server}} {{stage}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 90000,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    }
  ]
}
